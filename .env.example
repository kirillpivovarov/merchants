PORT=3000
HOST=127.0.0.1
DB_PATH=data/meridian.sqlite
# For an externally exposed Node server set AUTH_TOKEN to a long random secret.
# The login screen exchanges it for an HttpOnly SameSite session cookie.
AUTH_TOKEN=

# Set the exact HTTPS origin when serving behind a reverse proxy.
# PUBLIC_ORIGIN=https://monitor.example.com
COOKIE_SECURE=false
