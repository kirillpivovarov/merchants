{
  "name": "merchant-risk-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server/node.mjs",
    "build": "vite build && node scripts/build-worker.mjs",
    "start": "node server/node.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "regression": "npm run check && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "cheerio": "1.1.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "drizzle-kit": "0.31.6",
    "drizzle-orm": "0.44.7",
    "esbuild": "0.25.12",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
